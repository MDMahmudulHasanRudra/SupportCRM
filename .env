# Support CRM — environment template
# Copy to .env and fill in real values.  NEVER commit .env  (PROJECT_SPEC.md §109, §125)
#
# Generate the two secrets below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
TZ=Asia/Dhaka

# --- Serving (Docker) -------------------------------------------------------
WEB_PORT=12000
API_DEBUG_PORT=12001
POSTGRES_DEBUG_PORT=12002
REDIS_DEBUG_PORT=12003

# --- API -------------------------------------------------------------------
API_BASE_URL=http://api:4000
# Comma-separated exact origins. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000
ENABLE_SWAGGER=true

# --- PostgreSQL ------------------------------------------------------------
# Support CRM has its OWN database, separate from the gateway's. The boundary is enforced by the
# database itself so no cross-database join to gateway tables is possible (docs/adr/0001 §7).
POSTGRES_USER=support_crm
POSTGRES_PASSWORD=support_crm_dev_pw
POSTGRES_DB=support_crm

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=support_crm
DATABASE_PASSWORD=support_crm_dev_pw
DATABASE_NAME=support_crm
DATABASE_SSL=false
DATABASE_LOGGING=false

# --- Redis -----------------------------------------------------------------
# Queues, distributed locks, rate limits, job progress, dedupe.
# Never the source of truth for business data (PROJECT_SPEC.md §184).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=support-crm

# --- Security --------------------------------------------------------------
# 32 bytes, base64. Envelope key for every secret encrypted at rest.
# Rotating it makes existing ciphertext unreadable — see docs/SECURITY.md.
SECRET_ENCRYPTION_KEY=aX95BnSVBHsS3OQCj888Iz1E/DDAIcyQaFcy6Q0wLOY=
# At least 32 characters.
SESSION_COOKIE_SECRET=4dm-JlNojY4rWoXhtfNgP3RSd4A4QgxYev3eZWivTRQ
SESSION_COOKIE_NAME=support_crm_session
# Must be true in production (enforced at boot).
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12

# --- Worker ----------------------------------------------------------------
WORKER_HEALTH_PORT=4100
WORKER_CONCURRENCY=5

# --- OpenWA gateway --------------------------------------------------------
# Contract only in Phase 1; used from Phase 2. The gateway runs as its own service with its own
# database and its own API key — Support CRM talks to it over HTTP and webhooks only.
OPENWA_BASE_URL=http://openwa:2785
OPENWA_API_KEY=fO7baWjlWB5zADXWkXzxuybyioKLegPw06cAd92KHWU
# Shared secret the gateway signs webhook bodies with (X-OpenWA-Signature: sha256=...).
OPENWA_WEBHOOK_SECRET=

# --- First-boot seed -------------------------------------------------------
# The admin user is created only when the database has no users at all.
# The seed never resets an existing password. Production refuses to boot on the default below.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=-HLOT3mvSjkWwma5OtifjT3Z!aA1
