# Support CRM — environment template
# Copy to .env and fill in real values.  NEVER commit .env  (PROJECT_SPEC.md §109, §125)
#
# Generate the two secrets below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
TZ=Asia/Dhaka

# --- Serving (Docker) ------------------------------------------------------
# The console container (web) is the single public entry point. Its nginx serves the built frontend
# AND proxies /api and /socket.io to the api service on the compose network (apps/web/nginx.conf) —
# so the console and the API share one origin with no separate reverse-proxy container and nothing
# to install on the host.
#
# Public in every deployment, dev and production alike:
WEB_PORT=12000
# Browser: http://localhost:12000/  (or http://SERVER-IP:12000/ on a VPS)

# Debug-only, localhost-bound ports for manual testing (psql/redis-cli/curl straight at a service).
# Applied by docker-compose.override.yml, which Compose loads only for a plain `docker compose up`
# with no -f flags — a deployment naming its files explicitly (docker-compose.prod.yml) never
# publishes these, so they never reach a production host.
API_DEBUG_PORT=12001
POSTGRES_DEBUG_PORT=12002
REDIS_DEBUG_PORT=12003
# 12004 is reserved — not used by anything today.

# --- API -------------------------------------------------------------------
# What the WhatsApp gateway is told to POST webhooks to. It must be reachable FROM THE GATEWAY.
# Under Docker Compose the service name is correct and is the default; `localhost` there would mean
# the gateway itself, and inbound messages would silently never arrive. Only override this when the
# gateway runs outside the compose network.
API_BASE_URL=http://api:4000
# Comma-separated exact origins. "*" is rejected in production.
#
# The console and the API share an origin behind nginx, so CORS is not exercised at all in a Docker
# deployment — this covers `pnpm dev:web`, where the console is on :3000.
CORS_ORIGINS=http://localhost:3000
# Off in production: the schema explorer lists every administrative route (§201).
ENABLE_SWAGGER=true

# --- PostgreSQL ------------------------------------------------------------
# Support CRM has its OWN database, separate from the gateway's. The boundary is enforced by the
# database itself so no cross-database join to gateway tables is possible (docs/adr/0001 §7).
POSTGRES_USER=support_crm
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=support_crm

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=support_crm
DATABASE_PASSWORD=change_me_in_production
DATABASE_NAME=support_crm
DATABASE_SSL=false
DATABASE_LOGGING=false

# --- Redis -----------------------------------------------------------------
# Queues, distributed locks, rate limits, job progress, dedupe.
# Never the source of truth for business data (PROJECT_SPEC.md §184).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=support-crm

# --- Security --------------------------------------------------------------
# 32 bytes, base64. Envelope key for every secret encrypted at rest.
# Rotating it makes existing ciphertext unreadable — see docs/SECURITY.md.
SECRET_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# At least 32 characters.
SESSION_COOKIE_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
SESSION_COOKIE_NAME=support_crm_session
# Must be true in production (enforced at boot).
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12

# --- Worker ----------------------------------------------------------------
WORKER_HEALTH_PORT=4100
WORKER_CONCURRENCY=5

# --- WhatsApp gateway (OpenWA) — REQUIRED --------------------------------
# The gateway runs as the `openwa` service in this stack, built from `gateway/`. It has its own
# database, its own storage volume and its own API key; Support CRM talks to it over HTTP and
# webhooks only, and the browser never touches it.
#
# A Docker service name, NOT localhost: inside a container `localhost` means that container.
OPENWA_BASE_URL=http://openwa:2785
# REQUIRED in production. Shared by the CRM (X-API-Key) and the gateway (API_MASTER_KEY) — one
# value, both sides. Generate with the same command as the secrets above. Never reaches the browser.
OPENWA_API_KEY=
# Shared secret the gateway signs webhook bodies with (X-OpenWA-Signature: sha256=...).
OPENWA_WEBHOOK_SECRET=

# The gateway refuses to deliver webhooks to internal addresses (an SSRF guard). `api` is the one
# internal host Support CRM needs it to reach; the guard stays on for everything else. Without this,
# pairing works but no inbound message ever arrives.
OPENWA_SSRF_ALLOWED_HOSTS=api

# Resume already-authenticated sessions when the gateway boots. This is what makes a server reboot
# survivable. Only authenticated sessions resume — an unpaired account never starts a browser.
# Set false on a small VPS with many accounts and reconnect each one deliberately from the console.
OPENWA_AUTO_START_SESSIONS=true

# --- WhatsApp gateway resources — OPTIONAL --------------------------------
# Chromium is the reason this stack needs real memory: one WhatsApp session is a full browser.
# Measured: ~730 MB for one active session. Raise for more concurrent accounts.
# An exit code of 137 from the gateway means it was OOM-killed — raise this and the VPS.
OPENWA_MEM_LIMIT=2g
# Chromium's default 64 MB /dev/shm is not enough for WhatsApp Web.
OPENWA_SHM_SIZE=512m
# Fork-bomb guard, not an allocation. ~2048 fits 8-10 sessions. Never set -1.
OPENWA_PIDS_LIMIT=2048
OPENWA_LOG_LEVEL=info

# --- First-boot seed -------------------------------------------------------
# The admin user is created only when the database has no users at all.
# The seed never resets an existing password. Production refuses to boot on the default below.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!123

# --- Knowledge storage and embeddings (Phase 4) -------------------------------
# Where uploaded knowledge documents are written. MUST be outside any directory the
# API serves — an uploaded file that can be fetched and executed is the whole of
# PROJECT_SPEC.md §179 in one mistake.
STORAGE_DRIVER=local
# Where uploaded knowledge documents are written. Under Docker this is pinned to /app/storage by
# compose and backed by the `support_crm_storage` volume — the value here covers running on a host.
STORAGE_LOCAL_PATH=./var/storage
UPLOAD_MAX_BYTES=26214400

# Semantic search. `none` disables it honestly: documents still index and full-text
# search works, and the UI says semantic search is off. Nothing is ever faked.
#   none   - no semantic indexing (default)
#   openai - any OpenAI-compatible /embeddings endpoint
#   test   - deterministic offline provider; REFUSED in production
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Backend only. Never returned by an API, never logged, never sent to a client.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Fixed in the schema by vector(N). Changing it needs a migration and a re-embed.
EMBEDDING_DIMENSIONS=1536

# --- AI generation (Phase 6) --------------------------------------------------
# Two ways to configure a provider, and the database wins where both exist:
#
#   1. In the console, under AI → Providers. Keys are stored encrypted, several
#      providers can be ranked for fallback, and a failing one is rested by a
#      circuit breaker. This is the path to use in production.
#   2. These variables, for a single provider with no database row. Kept because
#      the integration suite drives it and because an existing deployment that
#      has always configured AI this way must keep working.
#
# With neither configured, `none` is the honest state: rules still run, and
# anything they cannot answer goes to a person. Nothing is ever guessed.
#   none   - no AI (default)
#   openai - any OpenAI-compatible /chat/completions endpoint
#   test   - scripted offline provider; REFUSED in production
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
# Backend only. Never returned by an API, never logged, never sent to a client.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=800
